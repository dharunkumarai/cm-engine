# ============================================================
# Valeon CM Engine — Environment Configuration
# ============================================================

# Database Configuration (matches docker-compose defaults)
DATABASE_URL=postgresql://postgres:valeon_dev@localhost:5432/valeon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=valeon_dev
POSTGRES_DB=valeon

# AI Agent Configuration
# Set MOCK_CLAUDE=false and supply ANTHROPIC_API_KEY to use live Claude 3.5/Sonnet
MOCK_CLAUDE=true
ANTHROPIC_API_KEY=

# CRM Integration (Mock MadeMarket Endpoint)
CRM_URL=http://localhost:3001

# Service Ports
MOCK_CRM_PORT=3001
AGENTS_PORT=3002
N8N_PORT=5678
DASHBOARD_PORT=5173
